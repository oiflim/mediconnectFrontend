{
  "expo": {
    "name": "MediConnect",
    "slug": "mediconnect",
    "scheme": "mediconnect",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#EAF7FB"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E7F8C",
          "defaultChannel": "mediconnect-updates"
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MediConnect uses the camera to attach prescription photos.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ],
      "expo-status-bar",
      "@clerk/expo",
      "expo-web-browser",
      "expo-font"
    ],
    "android": {
      "package": "com.mediconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF7FB"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mediconnect.app",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "bishalch02",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50dcf72d-f4ca-45ce-ab8f-dc63af2f0030"
      }
    }
  }
}
